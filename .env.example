# 必須: 同じ質問に回答する異なる Codex モデルをカンマで区切って指定する。
CODEX_COMPARE_MODELS=gpt-6.1-sol,gpt-6-luna

# 必須: 全モデル・全試行で共通の質問。
CODEX_COMPARE_QUESTION="LoRAとは何ですか？"

# 必須: 各モデルの試行回数。基礎課題では3回ずつ比較する。
CODEX_COMPARE_REPEATS=3

# 必須: 全モデルで共通の推論の強さ。指定するモデルが対応する値を使う。
CODEX_COMPARE_REASONING_EFFORT=medium

# 必須: 1試行の待機時間の上限（秒）。正の整数で指定する。
CODEX_COMPARE_TIMEOUT_SECONDS=180
