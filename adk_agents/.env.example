# 必須: Codex CLIで使うモデルと推論の強さ。Codexへのログインが必要。
AIE_CODEX_MODEL=gpt-6-luna
AIE_CODEX_REASONING_EFFORT=low

# 必須: 1回のCodex応答の制限時間（秒）と、1質問あたりの呼び出し上限。
AIE_CODEX_TIMEOUT_SECONDS=180
AIE_CODEX_MAX_REQUESTS=6

# 必須: タイムアウト・通信切断・利用制限での最大試行回数と待機秒数。正の整数。
AIE_CODEX_MAX_ATTEMPTS=2
AIE_CODEX_RETRY_DELAY_SECONDS=5

# 比較実験で必須: newは新規実験。再開時はoutput/配下の実行フォルダ名を指定。
AIE_RUN_DIRECTORY=new

# 必須: compareは比較実験、localはPydantic AI、adkはADK、plainは素の応答、list_toolsは一覧。
AIE_AGENT_MODE=compare

# 単独実行で必須: 質問とトレースの表示。AIE_TRACEはtrueまたはfalse。
AIE_QUESTION="第2回の内容から確認問題を1問出して"
AIE_TRACE=true

# 比較実験で必須: 素の応答・Pydantic AI・ADKに共通の質問をJSON配列で指定。
AIE_EXPERIMENT_QUESTIONS='["LoRAとは何ですか？", "AIE2026の講座で使う「lecNN-start タグ」とは何ですか？", "LoRAとQLoRAの違いは？", "第2回の内容から確認問題を1問出して"]'

# 必須: 構造化アプリログのレベル。
LOG_LEVEL=INFO
