# 必須: inspectは一覧、askは単独質問、compareは基礎比較、verify_quizはAPIなしの実装検証。
MCP_ACTION=inspect

# compareで必須: newは新規実験、実行フォルダ名を指定すると失敗箇所から再開。
AIE_RUN_DIRECTORY=new

# inspect・askで必須: directは関数を直接登録、mcpは設定ファイルのサーバーを使用。
MCP_CLIENT_MODE=mcp

# MCPクライアントで必須: このプロジェクトからの相対パス。
MCP_CONFIG_FILE=config/stdio.json

# directとサーバー起動で必須: briefまたはdetailed。講義要約ツールのdocstringを選ぶ。
MCP_DESCRIPTION_STYLE=brief

# サーバー起動で必須: stdioまたはstreamable-http。
MCP_TRANSPORT=stdio

# HTTPサーバー起動で必須: ローカルの待ち受けアドレスとポート番号。
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8767

# MCPクライアントで必須: 接続・応答の制限時間（秒）。正の整数。
MCP_TIMEOUT_SECONDS=30

# askで必須: 各接続方式に渡す質問。
MCP_QUESTION="AIE2026の講座の宿題にある「3レベル」とは何ですか？"

# ask・compareで必須: Codex CLIのモデルと推論の強さ。ログイン済みのCLIを使用。
AIE_CODEX_MODEL=gpt-6-luna
AIE_CODEX_REASONING_EFFORT=low

# ask・compareで必須: Codex応答の制限時間と1質問あたりのモデル要求上限。
AIE_CODEX_TIMEOUT_SECONDS=180
AIE_CODEX_MAX_REQUESTS=6

# ask・compareで必須: 一時的な通信失敗の最大試行回数と待機秒数。
AIE_CODEX_MAX_ATTEMPTS=2
AIE_CODEX_RETRY_DELAY_SECONDS=5

# 必須: アプリ・サーバーのログレベル。ログは標準エラーへJSONで出力。
LOG_LEVEL=INFO

# 任意: Pydantic AIの案内バナーを非表示にする。
PYDANTIC_AI_NO_BANNER=1
